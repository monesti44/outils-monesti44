<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Espace Outils MonEsti44</title>
<meta name="robots" content="noindex,nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap">
<style>
/* Mise en page : barre latérale fixe (navigation) + zone principale avec onglets façon navigateur ; tuiles d'outils en grille. */
:root{
  --navy:#0F2A44; --navy-2:#173a5c; --gold:#D9A62B; --gold-soft:#f6ead0; --slate:#5B6B7C;
  --bg:#f4f6f9; --surface:#ffffff; --surface-2:#eef2f6; --line:#dde3ea; --fg:#13263a; --muted:#5f6f80;
  --side:#0F2A44; --side-fg:#d6dee8; --side-active:#1e4468;
  --ok:#1f9254; --ok-bg:#e3f4ea; --warn:#b26a00; --warn-bg:#fff2dd; --bad:#b9382c; --bad-bg:#fbe7e4;
  --shadow:0 1px 2px rgba(15,42,68,.06),0 8px 24px rgba(15,42,68,.06);
  --f-display:"Sora","Segoe UI",system-ui,sans-serif; --f-body:"Manrope","Segoe UI",system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0c1724; --surface:#132235; --surface-2:#1a2c42; --line:#25384f; --fg:#e7edf4; --muted:#9aabbe;
  --side:#08121d; --side-fg:#b9c7d6; --side-active:#173a5c; --gold-soft:#3a2f14;
  --ok-bg:#123824; --warn-bg:#3a2a0e; --bad-bg:#3d1714; --ok:#5fd394; --warn:#f0b454; --bad:#ff8a7c;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0c1724; --surface:#132235; --surface-2:#1a2c42; --line:#25384f; --fg:#e7edf4; --muted:#9aabbe;
  --side:#08121d; --side-fg:#b9c7d6; --side-active:#173a5c; --gold-soft:#3a2f14;
  --ok-bg:#123824; --warn-bg:#3a2a0e; --bad-bg:#3d1714; --ok:#5fd394; --warn:#f0b454; --bad:#ff8a7c;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25); color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 var(--f-body)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
h1,h2,h3{font-family:var(--f-display);margin:0;text-wrap:balance;letter-spacing:-.01em}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
@media (prefers-reduced-motion: reduce){*{transition:none!important;animation:none!important}}

/* ---------- connexion ---------- */
#login{min-height:100%;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}
#login .art{background:var(--navy);color:#fff;padding:48px clamp(24px,5vw,72px);display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden}
#login .art::after{content:"";position:absolute;right:-120px;bottom:-120px;width:420px;height:420px;border-radius:50%;border:56px solid rgba(217,166,43,.16)}
#login .art h1{font-size:clamp(28px,3.4vw,44px);line-height:1.12;max-width:15ch;margin-top:40px}
#login .art h1 em{font-style:normal;color:var(--gold)}
#login .art p{color:#b8c6d6;max-width:42ch}
#login .art ul{list-style:none;padding:0;margin:26px 0 0;display:grid;gap:10px;color:#dfe7f0;position:relative;z-index:1}
#login .art li{display:flex;gap:10px;align-items:center}
#login .art li svg{flex:none;color:var(--gold)}
#login .formside{display:flex;align-items:center;justify-content:center;padding:32px 20px;background:var(--surface)}
#login form{width:min(380px,100%);display:grid;gap:16px}
#login form h2{font-size:24px}
.field{display:grid;gap:6px}
.field label{font-size:12.5px;font-weight:700;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}
.field input,.field select{border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:12px 14px;width:100%}
.field input:focus{border-color:var(--gold);outline:none;box-shadow:0 0 0 3px rgba(217,166,43,.25)}
.pw{position:relative}.pw button{position:absolute;right:8px;top:50%;transform:translateY(-50%);border:0;background:none;color:var(--muted);font-size:13px;font-weight:700}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:10px 16px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:8px;color:var(--fg)}
.btn:hover{border-color:var(--gold)}
.btn.pri{background:var(--navy);border-color:var(--navy);color:#fff}
.btn.pri:hover{background:var(--navy-2)}
.btn.gold{background:var(--gold);border-color:var(--gold);color:#1b1503}
.btn.sm{padding:6px 11px;font-size:13px;border-radius:8px}
.btn.ghost{background:transparent;border-color:transparent}
.btn.danger{color:var(--bad)}
.btn[disabled]{opacity:.55;cursor:wait}
.err{background:var(--bad-bg);color:var(--bad);border-radius:10px;padding:10px 12px;font-size:14px}
.note{font-size:13px;color:var(--muted)}
.brand{display:flex;align-items:center;gap:12px}
.brand b{font-family:var(--f-display);font-size:20px;letter-spacing:-.02em}
.brand b span{color:var(--gold)}
.brand small{display:block;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:inherit;opacity:.7;font-weight:600}

/* ---------- application ---------- */
#app{height:100%;display:grid;grid-template-columns:248px minmax(0,1fr)}
#side{background:var(--side);color:var(--side-fg);display:flex;flex-direction:column;padding:18px 14px;gap:18px;min-height:0}
#side .brand{color:#fff;padding:4px 6px}
#side nav{display:grid;gap:2px}
#side nav button{display:flex;align-items:center;gap:12px;border:0;background:none;color:inherit;text-align:left;padding:10px 12px;border-radius:10px;font-weight:600;font-size:14.5px}
#side nav button:hover{background:rgba(255,255,255,.06);color:#fff}
#side nav button.on{background:var(--side-active);color:#fff}
#side nav button.on svg{color:var(--gold)}
#side nav .sep{font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.55;padding:16px 12px 6px;font-weight:700}
#side .me{margin-top:auto;display:flex;align-items:center;gap:10px;padding:10px;border-radius:12px;background:rgba(255,255,255,.05)}
.av{width:36px;height:36px;border-radius:50%;background:var(--gold);color:#1b1503;display:grid;place-items:center;font-weight:800;font-family:var(--f-display);flex:none;font-size:14px}
#side .me div{min-width:0;flex:1}
#side .me b{display:block;color:#fff;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#side .me span{font-size:12px;opacity:.7}
#side .me button{border:0;background:none;color:inherit;opacity:.75;padding:4px;border-radius:8px}
#side .me button:hover{opacity:1;background:rgba(255,255,255,.08)}

#main{display:flex;flex-direction:column;min-width:0;min-height:0}
#topbar{display:flex;align-items:center;gap:12px;padding:12px clamp(16px,2.4vw,28px);background:var(--surface);border-bottom:1px solid var(--line)}
#burger{display:none;border:0;background:none;padding:6px}
.search{flex:1;max-width:560px;position:relative}
.search input{width:100%;border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:10px 16px 10px 42px}
.search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted)}
#demoTag{font-size:12px;font-weight:700;background:var(--warn-bg);color:var(--warn);padding:5px 10px;border-radius:999px;white-space:nowrap}
#tabs{display:flex;gap:4px;padding:8px clamp(16px,2.4vw,28px) 0;background:var(--surface);border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:thin}
#tabs button{display:flex;align-items:center;gap:8px;border:1px solid transparent;border-bottom:0;background:none;padding:9px 14px;border-radius:10px 10px 0 0;font-weight:600;font-size:14px;color:var(--muted);white-space:nowrap;position:relative;top:1px}
#tabs button.on{background:var(--bg);border-color:var(--line);color:var(--fg)}
#tabs button .x{width:20px;height:20px;border-radius:6px;display:grid;place-items:center;margin-right:-6px;font-size:15px;line-height:1}
#tabs button .x:hover{background:var(--surface-2)}
#tabs .dot{width:10px;height:10px;border-radius:3px;flex:none}
#views{flex:1;min-height:0;position:relative}
.view{position:absolute;inset:0;overflow:auto}
.pad{padding:clamp(18px,3vw,36px) clamp(16px,2.6vw,36px) 60px;max-width:1280px}

/* accueil */
.hero{border-radius:20px;background:linear-gradient(120deg,var(--navy) 0%,var(--navy-2) 58%,#2b5277 100%);color:#fff;padding:28px clamp(20px,3vw,36px);display:flex;gap:24px;align-items:center;justify-content:space-between;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;right:120px;top:-80px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(217,166,43,.35),transparent 70%)}
.hero h1{font-size:clamp(22px,2.6vw,32px)}
.hero p{margin:6px 0 0;color:#c6d3e1}
.hero .stats{display:flex;gap:26px;position:relative}
.hero .stats div{font-size:12.5px;color:#c6d3e1}
.hero .stats b{display:block;font-family:var(--f-display);font-size:26px;color:#fff;font-variant-numeric:tabular-nums}
.sectionhead{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:34px 0 14px;flex-wrap:wrap}
.sectionhead h2{font-size:19px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 14px;font-weight:600;font-size:13.5px;color:var(--muted)}
.chip:hover{color:var(--fg)}
.chip.on{background:var(--fg);border-color:var(--fg);color:var(--bg)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:18px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;text-align:left;padding:0;transition:transform .18s ease,box-shadow .18s ease,border-color .18s}
.card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:transparent}
.card.soon{cursor:default}
.card.soon:hover{transform:none;box-shadow:none;border-color:var(--line)}
.thumb{aspect-ratio:16/10;position:relative;display:grid;place-items:center;color:#fff;overflow:hidden;max-width:100%}
.thumb svg.big{width:54px;height:54px;position:relative;z-index:1;filter:drop-shadow(0 6px 14px rgba(0,0,0,.25))}
.thumb::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 15%,rgba(255,255,255,.28),transparent 45%),radial-gradient(circle at 10% 110%,rgba(0,0,0,.25),transparent 55%)}
.thumb .mini{position:absolute;inset:auto 14px 12px 14px;height:8px;border-radius:4px;background:rgba(255,255,255,.22)}
.thumb .mini::after{content:"";position:absolute;left:0;top:0;bottom:0;width:var(--w,55%);border-radius:4px;background:rgba(255,255,255,.65)}
.card .badge{position:absolute;top:10px;left:10px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:4px 8px;border-radius:6px;background:#fff;color:var(--navy);z-index:2}
.card .badge.soon{background:rgba(255,255,255,.88);color:var(--slate)}
.card.soon .thumb{filter:grayscale(.7) opacity(.75)}
.star{position:absolute;top:8px;right:8px;z-index:2;width:32px;height:32px;border-radius:9px;border:0;background:rgba(255,255,255,.18);color:#fff;display:grid;place-items:center;backdrop-filter:blur(4px)}
.star:hover{background:rgba(255,255,255,.32)}
.star.on{color:var(--gold);background:#fff}
.card .body{padding:14px 16px 16px;display:grid;gap:4px}
.card .body b{font-family:var(--f-display);font-size:15.5px;font-weight:600}
.card .body span{font-size:13.5px;color:var(--muted);line-height:1.45}
.card .cat{font-size:11.5px;font-weight:700;color:var(--gold);letter-spacing:.08em;text-transform:uppercase;margin-top:6px}
.empty{border:1.5px dashed var(--line);border-radius:16px;padding:26px;color:var(--muted);text-align:center}

/* outil ouvert */
.toolframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff}
.toolwait{position:absolute;inset:0;display:grid;place-items:center;color:var(--muted)}
.spin{width:34px;height:34px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--gold);animation:sp 0.9s linear infinite;margin:0 auto 12px}
@keyframes sp{to{transform:rotate(360deg)}}
.demotool{max-width:760px;margin:40px auto;padding:0 20px;text-align:center}
.demotool .thumb{border-radius:18px;margin-bottom:22px}
.demotool p{color:var(--muted)}

/* administration */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:16px}
.panel .ph{display:flex;align-items:center;gap:12px;padding:16px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.panel .ph h3{font-size:16px;flex:1}
.switch{display:flex;align-items:center;gap:12px;padding:16px 18px;border-radius:16px;flex-wrap:wrap}
.switch.open{background:var(--ok-bg)} .switch.closed{background:var(--bad-bg)}
.switch b{font-family:var(--f-display)}
.switch .txt{flex:1;min-width:220px}
.switch .txt span{display:block;font-size:13.5px;color:var(--muted)}
.tog{width:48px;height:28px;border-radius:999px;border:0;background:var(--line);position:relative;flex:none;padding:0}
.tog::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:left .15s}
.tog.on{background:var(--ok)} .tog.on::after{left:23px}
.tablewrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700;padding:10px 14px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:middle}
tr:last-child td{border-bottom:0}
td .who{display:flex;align-items:center;gap:10px}
td .who .av{width:32px;height:32px;font-size:12px;background:var(--surface-2);color:var(--fg)}
td .who b{display:block;font-weight:700}
td .who span{font-size:12.5px;color:var(--muted)}
.pill{display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:700;padding:4px 10px;border-radius:999px;white-space:nowrap}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.pill.ok{background:var(--ok-bg);color:var(--ok)} .pill.off{background:var(--bad-bg);color:var(--bad)} .pill.adm{background:var(--gold-soft);color:var(--warn)}
.pill.adm::before{display:none}
.tiny{font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums}
.acts{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap}
.cols{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:18px;margin-top:18px}
.log{list-style:none;margin:0;padding:6px 18px 14px;display:grid}
.log li{display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 12px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13.5px}
.log li:last-child{border-bottom:0}
.log time{color:var(--muted);font-variant-numeric:tabular-nums;font-size:12.5px}

/* tiroir / fenêtre */
.overlay{position:fixed;inset:0;background:rgba(8,18,29,.5);z-index:40;display:flex;align-items:center;justify-content:center;padding:20px}
.dlg{background:var(--surface);border-radius:18px;width:min(520px,100%);max-height:100%;overflow:auto;box-shadow:0 30px 80px rgba(0,0,0,.35)}
.dlg .dh{display:flex;align-items:center;gap:10px;padding:18px 20px;border-bottom:1px solid var(--line)}
.dlg .dh h3{flex:1;font-size:18px}
.dlg .db{padding:18px 20px;display:grid;gap:14px}
.dlg .df{padding:14px 20px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap}
.checks{display:grid;gap:6px;max-height:220px;overflow:auto;border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.checks label{display:flex;align-items:center;gap:10px;font-size:14px}
.secret{background:var(--gold-soft);border-radius:12px;padding:14px 16px;display:grid;gap:8px}
.secret code{font:700 20px/1.2 ui-monospace,Consolas,monospace;letter-spacing:.04em;word-break:break-all}
.msgbox{white-space:pre-wrap;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:13.5px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--navy);color:#fff;padding:12px 18px;border-radius:12px;z-index:60;font-weight:600;box-shadow:0 10px 30px rgba(0,0,0,.25);max-width:calc(100% - 32px)}

/* aide */
.steps{display:grid;gap:12px;counter-reset:s;max-width:760px}
.steps li{list-style:none;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px 14px 56px;position:relative;counter-increment:s}
.steps li::before{content:counter(s);position:absolute;left:16px;top:14px;width:26px;height:26px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:800;font-size:13px}
.steps{padding:0}

/* responsive */
@media (max-width:900px){
  #login{grid-template-columns:1fr} #login .art{padding:28px 20px} #login .art h1{margin-top:20px}
  #app{grid-template-columns:1fr}
  #side{position:fixed;inset:0 auto 0 0;width:260px;z-index:30;transform:translateX(-100%);transition:transform .2s}
  #app.menu #side{transform:none;box-shadow:0 0 60px rgba(0,0,0,.4)}
  #burger{display:block}
  .cols{grid-template-columns:1fr}
  .hero{flex-direction:column;align-items:flex-start}
  #demoTag{display:none}
}
</style>
</head>
<body>

<div id="login" hidden>
  <section class="art">
    <div class="brand"><svg width="44" height="44" viewBox="0 0 96 96" aria-hidden="true"><rect width="96" height="96" rx="22" fill="#0b2034"/><path d="M18 50 48 24l30 26" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><rect x="29" y="47" width="38" height="30" rx="5" fill="#5B6B7C"/><circle cx="48" cy="62" r="10" fill="none" stroke="#D9A62B" stroke-width="4" stroke-dasharray="4 3"/><circle cx="48" cy="62" r="4" fill="#D9A62B"/></svg>
      <div><b>monesti<span>44</span></b><small>Espace outils</small></div></div>
    <div>
      <h1>Les outils de terrain, <em>prêts en un clic.</em></h1>
      <p>Estimations, rendus clients, vidéos de biens : l'espace réservé aux conseillers invités par Nathan Frémont.</p>
      <ul>
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 12.5l5 5L20 6.5"/></svg>Rien à installer, tout s'ouvre dans le navigateur</li>
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 12.5l5 5L20 6.5"/></svg>Vos dossiers restent sur votre ordinateur</li>
        <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 12.5l5 5L20 6.5"/></svg>Accès personnel, sur invitation uniquement</li>
      </ul>
    </div>
    <p class="note" style="color:#8ea3ba;position:relative;z-index:1">© Nathan Frémont · outils développés à titre personnel</p>
  </section>
  <section class="formside">
    <form id="loginForm" novalidate>
      <h2>Connexion</h2>
      <p class="note" style="margin:-8px 0 4px">Utilisez l'adresse e-mail et le mot de passe reçus par e-mail.</p>
      <div class="field"><label for="lgEmail">Adresse e-mail</label><input id="lgEmail" type="email" autocomplete="username" required placeholder="prenom.nom@agencebenoit.fr"></div>
      <div class="field"><label for="lgPw">Mot de passe</label><div class="pw"><input id="lgPw" type="password" autocomplete="current-password" required><button type="button" id="lgShow">Afficher</button></div></div>
      <label class="note" style="display:flex;gap:8px;align-items:center"><input id="lgRemember" type="checkbox" checked> Rester connecté sur cet ordinateur (7 jours)</label>
      <div id="lgErr" class="err" hidden></div>
      <button class="btn pri" id="lgBtn" type="submit">Se connecter</button>
      <p class="note">Mot de passe oublié ou accès bloqué ? Contactez Nathan Frémont au 06 72 45 76 60.</p>
      <p class="note" id="lgDemo" hidden>Démonstration : choisissez « Se connecter », les champs sont déjà remplis.</p>
    </form>
  </section>
</div>

<div id="app" hidden>
  <aside id="side">
