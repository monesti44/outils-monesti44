const ic = (n, cls = "", s = 20) => `<svg class="${cls}" width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[n] || ICONS.tool}</svg>`;
const NAVIC = {
  accueil: '<path d="M3 11.5 12 4l9 7.5V20h-6v-5h-6v5H3z"/>', outils: '<rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/>',
  favoris: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>', admin: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
  aide: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 114 2c-.9.6-1.5 1.1-1.5 2.2M12 17h.01"/>',
};
const navic = n => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${NAVIC[n]}</svg>`;

/* ======================================================================
   Accès au serveur (Apps Script) ou démonstration
   ====================================================================== */
async function api(action, data = {}) {
  if (DEMO) return demoApi(action, data);
  const r = await fetch(API_URL, {method: "POST", headers: {"Content-Type": "text/plain;charset=utf-8"}, body: JSON.stringify({action, token: S.token, ...data})});
  const j = await r.json();
  if (!j.ok) { const e = new Error(j.error || "Erreur inconnue"); e.code = j.code; throw e; }
  return j;
}

/* ---------- démonstration (données d'exemple, rien n'est envoyé) ---------- */
const DEMO_DB = {
  portail: true,
  outils: [
    {id: "studio-estimation", nom: "Studio Estimation", description: "Rendu d'estimation Agence Benoit pré-rempli : fiche R1, comparables, prix, présentation et PDF.", categorie: "Estimation", type: "fichier", couleur: "#0F2A44", icone: "estimation", actif: true, nouveau: true},
    {id: "studio-vente", nom: "Studio Vente Immo", description: "Montage vidéo des biens pour Instagram et TikTok, avec textes et musique.", categorie: "Réseaux sociaux", type: "fichier", couleur: "#9c3d6b", icone: "video", actif: true},
    {id: "monesti44", nom: "MonEsti44", description: "Le site d'estimation en ligne à partager aux vendeurs (stories, bio, SMS).", categorie: "Prospection", type: "lien", url: "https://www.monesti44.fr", couleur: "#b8871c", icone: "web", actif: true},
    {id: "registre", nom: "Registre des confrères", description: "Agents et agences par secteur en Loire-Atlantique pour l'inter-agence.", categorie: "Vente", type: "fichier", couleur: "#2f6f62", icone: "users", actif: false},
    {id: "flyers-dpe", nom: "Flyers prospection DPE", description: "Flyers personnalisés à partir des nouveaux DPE autour de Nantes.", categorie: "Prospection", type: "fichier", couleur: "#4c5fa8", icone: "flyer", actif: false},
    {id: "dossier-acquereur", nom: "Dossier acquéreur", description: "La synthèse remise en fin de visite, générée depuis le dossier de vente.", categorie: "Vente", type: "fichier", couleur: "#7a5a35", icone: "folder", actif: false},
  ],
  users: [
    {email: "nathan.fremont@agencebenoit.fr", nom: "Nathan Frémont", role: "admin", actif: true, outils: "tous", cree: "2026-10-05", derniere: "2026-10-05T21:40", nb: 12},
    {email: "camille.exemple@agencebenoit.fr", nom: "Camille Exemple", role: "membre", actif: true, outils: "studio-estimation,monesti44", cree: "2026-10-05", derniere: "2026-10-05T18:12", nb: 3},
    {email: "lucas.exemple@agencebenoit.fr", nom: "Lucas Exemple", role: "membre", actif: true, outils: "tous", cree: "2026-10-04", derniere: "", nb: 0},
    {email: "ancien.collegue@exemple.fr", nom: "Ancien collègue (exemple)", role: "membre", actif: false, outils: "tous", cree: "2026-09-20", derniere: "2026-09-30T10:05", nb: 7},
  ],
  journal: [
    ["2026-10-05T21:40", "nathan.fremont@agencebenoit.fr", "Connexion", ""],
    ["2026-10-05T18:15", "camille.exemple@agencebenoit.fr", "Ouverture", "Studio Estimation"],
    ["2026-10-05T18:12", "camille.exemple@agencebenoit.fr", "Connexion", ""],
    ["2026-10-04T09:30", "nathan.fremont@agencebenoit.fr", "Accès désactivé", "ancien.collegue@exemple.fr"],
    ["2026-10-04T09:28", "nathan.fremont@agencebenoit.fr", "Accès créé", "lucas.exemple@agencebenoit.fr"],
  ],
};
const MOTS = ["Loire", "Erdre", "Galion", "Tram", "Doulon", "Atlantique", "Graslin", "Bouffay", "Talensac", "Chantenay", "Pornic", "Sevre", "Cedre", "Ardoise", "Phare", "Marais"];
function genPassword() {
  const r = n => { const a = new Uint32Array(1); crypto.getRandomValues(a); return a[0] % n; };
  return `${MOTS[r(MOTS.length)]}-${MOTS[r(MOTS.length)]}-${10 + r(90)}${"!?#*+"[r(5)]}`;
}
function demoTools(u) { return DEMO_DB.outils.map(o => ({...o, autorise: o.actif && (u.outils === "tous" || u.outils.split(",").includes(o.id))})); }
async function demoApi(action, d) {
  await new Promise(r => setTimeout(r, 250));
  const me = DEMO_DB.users[0];
  const log = (a, x) => DEMO_DB.journal.unshift([new Date().toISOString().slice(0, 16), me.email, a, x || ""]);
  switch (action) {
    case "login": return {ok: true, token: "demo", user: {email: me.email, nom: me.nom, role: me.role}, outils: demoTools(me)};
    case "me": return {ok: true, user: {email: me.email, nom: me.nom, role: me.role}, outils: demoTools(me)};
    case "ouvrir": { const o = DEMO_DB.outils.find(x => x.id === d.id); log("Ouverture", o.nom); return {ok: true, demo: true, url: o.url}; }
    case "motdepasse": return {ok: true};
    case "admin.etat": return {ok: true, portail: DEMO_DB.portail, users: DEMO_DB.users, outils: DEMO_DB.outils, journal: DEMO_DB.journal.slice(0, 30)};
    case "admin.creer": {
      if (DEMO_DB.users.some(u => u.email === d.email)) throw Object.assign(new Error("Cette adresse a déjà un accès."), {});
      const pw = genPassword(); DEMO_DB.users.push({email: d.email, nom: d.nom, role: "membre", actif: true, outils: d.outils, cree: new Date().toISOString().slice(0, 10), derniere: "", nb: 0});
      log("Accès créé", d.email); return {ok: true, password: pw, mailEnvoye: d.envoyer};
    }
    case "admin.modifier": { const u = DEMO_DB.users.find(x => x.email === d.email); Object.assign(u, d.champs); log(d.champs.actif === false ? "Accès désactivé" : d.champs.actif === true ? "Accès réactivé" : "Accès modifié", d.email); return {ok: true}; }
    case "admin.reinit": { log("Mot de passe réinitialisé", d.email); return {ok: true, password: genPassword(), mailEnvoye: d.envoyer}; }
    case "admin.supprimer": { DEMO_DB.users = DEMO_DB.users.filter(x => x.email !== d.email); log("Accès supprimé", d.email); return {ok: true}; }
    case "admin.portail": { DEMO_DB.portail = d.ouvert; log(d.ouvert ? "Portail ouvert" : "Portail fermé"); return {ok: true}; }
  }
  throw new Error("Action inconnue");
}

/* ======================================================================
   État et rendu
   ====================================================================== */
const S = {token: null, user: null, outils: [], view: "accueil", cat: "Tout", q: "", tabs: [], admin: null, frames: {}};
const favs = () => store.get("me44.favs", []);
const recents = () => store.get("me44.recents", []);
function toast(m) { const t = document.createElement("div"); t.className = "toast"; t.textContent = m; document.body.appendChild(t); setTimeout(() => t.remove(), 3200); }
const initials = n => (n || "?").split(/[\s.@-]+/).filter(Boolean).slice(0, 2).map(x => x[0].toUpperCase()).join("");
const fmtDate = s => { if (!s) return "jamais"; const d = new Date(s); if (isNaN(d)) return s; return d.toLocaleDateString("fr-FR", {day: "2-digit", month: "short"}) + (String(s).length > 10 ? " · " + d.toLocaleTimeString("fr-FR", {hour: "2-digit", minute: "2-digit"}) : ""); };

function showLogin(msg) {
  $("#app").hidden = true; $("#login").hidden = false;
  if (DEMO) { $("#lgEmail").value = DEMO_DB.users[0].email; $("#lgPw").value = "demonstration"; $("#lgDemo").hidden = false; }
  const e = $("#lgErr"); e.hidden = !msg; e.textContent = msg || "";
}
function enter(j) {
  S.user = j.user; S.outils = j.outils || [];
  $("#login").hidden = true; $("#app").hidden = false; $("#demoTag").hidden = !DEMO;
  $("#meAv").textContent = initials(S.user.nom || S.user.email); $("#meName").textContent = S.user.nom || S.user.email;
  $("#meRole").textContent = S.user.role === "admin" ? "Administrateur" : "Conseiller";
  renderNav(); renderTabs(); go(S.view);
}
function renderNav() {
  const items = [["accueil", "Accueil"], ["outils", "Tous les outils"], ["favoris", "Mes favoris"]];
  let h = items.map(([k, l]) => `<button data-nav="${k}" class="${S.view === k ? "on" : ""}">${navic(k)}${l}</button>`).join("");
  if (S.user.role === "admin") h += `<div class="sep">Gestion</div><button data-nav="admin" class="${S.view === "admin" ? "on" : ""}">${navic("admin")}Accès et comptes</button>`;
  h += `<div class="sep">Support</div><button data-nav="aide" class="${S.view === "aide" ? "on" : ""}">${navic("aide")}Aide</button>`;
  $("#nav").innerHTML = h;
}
function renderTabs() {
  const tabs = [`<button role="tab" class="${!S.view.startsWith("t:") ? "on" : ""}" data-nav="accueil">${navic("accueil")}Accueil</button>`];
  S.tabs.forEach(id => { const o = S.outils.find(x => x.id === id); if (!o) return; tabs.push(`<button role="tab" class="${S.view === "t:" + id ? "on" : ""}" data-tab="${id}"><span class="dot" style="background:${esc(o.couleur)}"></span>${esc(o.nom)}<span class="x" data-close="${id}" title="Fermer l'onglet">×</span></button>`); });
  $("#tabs").innerHTML = tabs.join("");
}
function thumb(o, w = "55%") {
  return `<div class="thumb" style="background:${esc(o.couleur)}">${ic(o.icone, "big", 54)}</div>`;
}
function card(o) {
  const soon = !o.actif, locked = o.actif && !o.autorise; const f = favs().includes(o.id);
  return `<button class="card ${soon || locked ? "soon" : ""}" data-open="${o.id}" ${soon || locked ? 'aria-disabled="true"' : ""}>
    <div style="position:relative">${thumb(o, (o.nom.length * 4 % 60 + 30) + "%")}
      ${soon ? '<span class="badge soon">Bientôt</span>' : locked ? '<span class="badge soon">Non autorisé</span>' : o.nouveau ? '<span class="badge">Nouveau</span>' : o.type === "lien" ? '<span class="badge">Lien</span>' : ""}
      ${!soon && !locked ? `<span class="star ${f ? "on" : ""}" data-fav="${o.id}" role="button" aria-label="${f ? "Retirer des favoris" : "Ajouter aux favoris"}"><svg width="16" height="16" viewBox="0 0 24 24" fill="${f ? "currentColor" : "none"}" stroke="currentColor" stroke-width="2">${NAVIC.favoris}</svg></span>` : ""}</div>
    <div class="body"><b>${esc(o.nom)}</b><span>${esc(o.description)}</span><div class="cat">${esc(o.categorie)}</div></div></button>`;
}
function visibleTools(list) {
  const q = S.q.trim().toLowerCase();
  return list.filter(o => (S.cat === "Tout" || o.categorie === S.cat) && (!q || (o.nom + " " + o.description + " " + o.categorie).toLowerCase().includes(q)));
}
function catsBar() {
  const cats = ["Tout", ...new Set(S.outils.map(o => o.categorie))];
  return `<div class="chips">${cats.map(c => `<button class="chip ${S.cat === c ? "on" : ""}" data-cat="${esc(c)}">${esc(c)}</button>`).join("")}</div>`;
}
function viewHome() {
  const dispo = S.outils.filter(o => o.actif && o.autorise);
  const rec = recents().map(id => S.outils.find(o => o.id === id)).filter(o => o && o.autorise).slice(0, 4);
  const h = new Date().getHours(); const salut = h < 18 ? "Bonjour" : "Bonsoir";
  return `<div class="pad">
    <section class="hero"><div style="position:relative"><h1>${salut} ${esc((S.user.nom || "").split(" ")[0])}</h1><p>Choisissez un outil : il s'ouvre dans un onglet, vous passez de l'un à l'autre en haut de l'écran.</p></div>
      <div class="stats"><div><b>${dispo.length}</b>outils disponibles</div><div><b>${S.outils.filter(o => !o.actif).length}</b>en préparation</div></div></section>
    ${rec.length ? `<div class="sectionhead"><h2>Repris récemment</h2></div><div class="grid">${rec.map(card).join("")}</div>` : ""}
    <div class="sectionhead"><h2>Tous les outils</h2>${catsBar()}</div>
    ${toolGrid(S.outils)}</div>`;
}
function toolGrid(list) { const v = visibleTools(list).sort((a, b) => (b.actif && b.autorise) - (a.actif && a.autorise)); return v.length ? `<div class="grid">${v.map(card).join("")}</div>` : `<div class="empty">Aucun outil ne correspond à « ${esc(S.q)} ».</div>`; }
function viewOutils() { return `<div class="pad"><div class="sectionhead" style="margin-top:0"><h2>Tous les outils</h2>${catsBar()}</div>${toolGrid(S.outils)}</div>`; }
function viewFavoris() {
  const l = favs().map(id => S.outils.find(o => o.id === id)).filter(Boolean);
  return `<div class="pad"><div class="sectionhead" style="margin-top:0"><h2>Mes favoris</h2></div>${l.length ? `<div class="grid">${l.map(card).join("")}</div>` : `<div class="empty">Ajoutez un outil à vos favoris avec l'étoile en haut à droite de sa vignette.</div>`}</div>`;
}
function viewAide() {
  return `<div class="pad"><div class="sectionhead" style="margin-top:0"><h2>Comment ça marche</h2></div>
    <ol class="steps">
      <li><b>Ouvrir un outil.</b> Cliquez sur sa vignette : il s'ouvre dans un nouvel onglet en haut de l'écran. Vous pouvez en garder plusieurs ouverts.</li>
      <li><b>Vos données restent chez vous.</b> Les dossiers créés dans un outil sont enregistrés dans le navigateur de cet ordinateur. Utilisez toujours le même navigateur et pensez à exporter vos dossiers importants.</li>
      <li><b>Changer de mot de passe.</b> Cadenas en bas à gauche, à côté de votre nom.</li>
      <li><b>Un problème, une idée d'outil ?</b> Appelez Nathan Frémont au 06 72 45 76 60.</li>
    </ol>
    <p class="note" style="margin-top:22px;max-width:70ch">Ces outils sont développés et mis à disposition à titre personnel par Nathan Frémont. L'accès est nominatif : merci de ne pas partager vos identifiants. Il peut être retiré à tout moment.</p></div>`;
}

/* ---------- administration ---------- */
async function loadAdmin() { S.admin = await api("admin.etat"); }
function viewAdmin() {
  const A = S.admin; if (!A) return `<div class="toolwait"><div><div class="spin"></div>Chargement des accès…</div></div>`;
  const actifs = A.users.filter(u => u.actif).length;
  const nomsOutils = ids => ids === "tous" ? "Tous les outils" : ids.split(",").filter(Boolean).map(id => (A.outils.find(o => o.id === id) || {}).nom || id).join(", ") || "Aucun";
  return `<div class="pad">
    <div class="sectionhead" style="margin-top:0"><h2>Accès et comptes</h2><button class="btn gold" data-do="add">+ Inviter un collègue</button></div>
    <div class="switch ${A.portail ? "open" : "closed"}"><div class="txt"><b>${A.portail ? "Portail ouvert" : "Portail fermé"}</b><span>${A.portail ? `${actifs} personne${actifs > 1 ? "s" : ""} peu${actifs > 1 ? "vent" : "t"} se connecter. Fermer le portail coupe l'accès de tout le monde sauf le vôtre, immédiatement.` : "Plus personne ne peut se connecter ni ouvrir un outil, sauf vous. Rouvrez quand vous voulez."}</span></div>
      <button class="tog ${A.portail ? "on" : ""}" data-do="portail" aria-label="Ouvrir ou fermer le portail" aria-pressed="${A.portail}"></button></div>
    <div class="cols">
      <section class="panel"><div class="ph"><h3>Personnes invitées</h3><span class="tiny">${A.users.length} compte${A.users.length > 1 ? "s" : ""}</span></div>
        <div class="tablewrap"><table><thead><tr><th>Personne</th><th>Statut</th><th>Outils</th><th>Dernière connexion</th><th></th></tr></thead><tbody>
        ${A.users.map(u => `<tr><td><div class="who"><div class="av">${initials(u.nom || u.email)}</div><div><b>${esc(u.nom)}</b><span>${esc(u.email)}</span></div></div></td>
          <td>${u.role === "admin" ? '<span class="pill adm">Administrateur</span>' : u.actif ? '<span class="pill ok">Actif</span>' : '<span class="pill off">Désactivé</span>'}</td>
          <td class="tiny" style="max-width:220px">${esc(nomsOutils(u.outils))}</td><td class="tiny">${fmtDate(u.derniere)}${u.nb ? ` · ${u.nb} connexion${u.nb > 1 ? "s" : ""}` : ""}</td>
          <td>${u.role === "admin" ? "" : `<div class="acts">${u.actif ? `<button class="btn sm danger" data-do="off" data-email="${esc(u.email)}">Désactiver</button>` : `<button class="btn sm" data-do="on" data-email="${esc(u.email)}">Réactiver</button>`}<button class="btn sm" data-do="edit" data-email="${esc(u.email)}">Modifier</button></div>`}</td></tr>`).join("")}
        </tbody></table></div></section>
      <section class="panel"><div class="ph"><h3>Journal</h3><span class="tiny">30 derniers événements</span></div>
        <ul class="log">${A.journal.map(([t, e, a, x]) => `<li><time>${fmtDate(t)}</time><div><b>${esc(a)}</b>${x ? " · " + esc(x) : ""}<div class="tiny">${esc(e)}</div></div></li>`).join("") || '<li class="tiny">Rien pour l\'instant.</li>'}</ul></section>
    </div>
    <p class="note" style="margin-top:18px">La liste des outils (nom, description, fichier, catégorie) se modifie dans l'onglet « Outils » de la Google Sheet du portail.</p></div>`;
}
function dialog(title, body, foot) {
  const o = document.createElement("div"); o.className = "overlay";
  o.innerHTML = `<div class="dlg" role="dialog" aria-modal="true" aria-label="${esc(title)}"><div class="dh"><h3>${esc(title)}</h3><button class="btn sm ghost" data-x aria-label="Fermer">✕</button></div><div class="db">${body}</div>${foot ? `<div class="df">${foot}</div>` : ""}</div>`;
  o.addEventListener("mousedown", e => { if (e.target === o) o.remove(); });
  o.addEventListener("click", e => { if (e.target.closest("[data-x]")) o.remove(); });
  document.body.appendChild(o); return o;
}
function toolChecks(sel) {
  const all = sel === "tous";
  return `<div class="checks"><label><input type="checkbox" id="ckAll" ${all ? "checked" : ""}> <b>Tous les outils</b> (y compris les futurs)</label>
    ${S.admin.outils.map(o => `<label><input type="checkbox" class="ckT" value="${esc(o.id)}" ${all || sel.split(",").includes(o.id) ? "checked" : ""} ${all ? "disabled" : ""}> ${esc(o.nom)} ${o.actif ? "" : '<span class="tiny">(bientôt)</span>'}</label>`).join("")}</div>`;
}
function readChecks(o) { if ($("#ckAll", o).checked) return "tous"; return [...o.querySelectorAll(".ckT:checked")].map(c => c.value).join(","); }
function wireChecks(o) { $("#ckAll", o).onchange = e => o.querySelectorAll(".ckT").forEach(c => { c.disabled = e.target.checked; if (e.target.checked) c.checked = true; }); }
function invitationText(nom, email, pw) {
  const url = PORTAIL_URL;
  return `Bonjour ${(nom || "").split(" ")[0]},\n\nTon accès à l'espace outils est prêt.\n\nAdresse : ${url}\nIdentifiant : ${email}\nMot de passe : ${pw}\n\nTu pourras changer ce mot de passe après ta première connexion (cadenas en bas à gauche).\n\nNathan`;
}
function showSecret(title, nom, email, r) {
  const txt = invitationText(nom, email, r.password);
  const o = dialog(title, `<div class="secret"><span class="note">Mot de passe généré</span><code>${esc(r.password)}</code></div>
    <p class="note" style="margin:0">${r.mailEnvoye ? `Un e-mail avec ces informations vient d'être envoyé à ${esc(email)} depuis votre Gmail.` : "Aucun e-mail n'a été envoyé. Copiez le message ci-dessous et transmettez-le vous-même."} Ce mot de passe ne sera plus jamais affiché.</p>
    <div class="msgbox" id="msgTxt">${esc(txt)}</div>`, `<button class="btn" data-copy>Copier le message</button><button class="btn pri" data-x>Terminé</button>`);
  $("[data-copy]", o).onclick = async () => { try { await navigator.clipboard.writeText(txt); toast("Message copié."); } catch (e) { const r = document.createRange(); r.selectNodeContents($("#msgTxt", o)); getSelection().removeAllRanges(); getSelection().addRange(r); toast("Texte sélectionné : Ctrl+C pour copier."); } };
}
function addDialog() {
  const o = dialog("Inviter un collègue", `
    <div class="field"><label for="adNom">Prénom et nom</label><input id="adNom" placeholder="Camille Martin"></div>
    <div class="field"><label for="adEmail">Adresse e-mail</label><input id="adEmail" type="email" placeholder="camille.martin@agencebenoit.fr"></div>
    <div class="field"><label>Outils autorisés</label>${toolChecks("tous")}</div>
    <label class="note" style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="adSend" checked> Envoyer l'invitation par e-mail (depuis votre Gmail)</label>
    <div class="err" id="adErr" hidden></div>`, `<button class="btn" data-x>Annuler</button><button class="btn pri" id="adGo">Créer l'accès</button>`);
  wireChecks(o); $("#adNom", o).focus();
  $("#adGo", o).onclick = async () => {
    const nom = $("#adNom", o).value.trim(), email = $("#adEmail", o).value.trim().toLowerCase();
    const err = $("#adErr", o);
    if (!nom || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { err.hidden = false; err.textContent = "Indiquez un nom et une adresse e-mail valide."; return; }
    const b = $("#adGo", o); b.disabled = true; b.textContent = "Création…";
    try { const r = await api("admin.creer", {nom, email, outils: readChecks(o), envoyer: $("#adSend", o).checked}); o.remove(); await loadAdmin(); go("admin"); showSecret("Accès créé", nom, email, r); }
    catch (e) { err.hidden = false; err.textContent = e.message; b.disabled = false; b.textContent = "Créer l'accès"; }
  };
}
function editDialog(email) {
  const u = S.admin.users.find(x => x.email === email);
  const o = dialog(`Modifier l'accès de ${u.nom}`, `
    <div class="field"><label for="edNom">Prénom et nom</label><input id="edNom" value="${esc(u.nom)}"></div>
    <div class="field"><label>Outils autorisés</label>${toolChecks(u.outils)}</div>
    <div class="panel" style="padding:14px;display:grid;gap:10px"><b style="font-family:var(--f-display)">Mot de passe</b><span class="note">Génère un nouveau mot de passe. L'ancien ne fonctionne plus et ${esc(u.nom.split(" ")[0])} est déconnecté partout.</span>
      <label class="note" style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="edSend" checked> Lui envoyer par e-mail</label><button class="btn sm" id="edReset" style="justify-self:start">Générer un nouveau mot de passe</button></div>
    <div class="panel" style="padding:14px;display:grid;gap:10px;border-color:var(--bad-bg)"><b style="font-family:var(--f-display);color:var(--bad)">Supprimer le compte</b><span class="note">Préférez « Désactiver » : le compte reste dans l'historique et peut être réactivé.</span>
      <div id="delZone"><button class="btn sm danger" id="edDel">Supprimer définitivement</button></div></div>`,
    `<button class="btn" data-x>Annuler</button><button class="btn pri" id="edSave">Enregistrer</button>`);
  wireChecks(o);
  $("#edSave", o).onclick = async () => { await api("admin.modifier", {email, champs: {nom: $("#edNom", o).value.trim(), outils: readChecks(o)}}); o.remove(); await loadAdmin(); go("admin"); toast("Accès mis à jour."); };
  $("#edReset", o).onclick = async () => { const r = await api("admin.reinit", {email, envoyer: $("#edSend", o).checked}); o.remove(); await loadAdmin(); go("admin"); showSecret("Nouveau mot de passe", u.nom, email, r); };
  $("#edDel", o).onclick = () => { $("#delZone", o).innerHTML = `<span class="note">Confirmer la suppression de ${esc(u.email)} ?</span> <button class="btn sm danger" id="edDel2">Oui, supprimer</button>`; $("#edDel2", o).onclick = async () => { await api("admin.supprimer", {email}); o.remove(); await loadAdmin(); go("admin"); toast("Compte supprimé."); }; };
}
function pwDialog() {
  const o = dialog("Changer mon mot de passe", `
    <div class="field"><label for="pwOld">Mot de passe actuel</label><input id="pwOld" type="password" autocomplete="current-password"></div>
    <div class="field"><label for="pwNew">Nouveau mot de passe (10 caractères minimum)</label><input id="pwNew" type="password" autocomplete="new-password"></div>
    <div class="err" id="pwErr" hidden></div>`, `<button class="btn" data-x>Annuler</button><button class="btn pri" id="pwGo">Enregistrer</button>`);
  $("#pwGo", o).onclick = async () => {
    const n = $("#pwNew", o).value, err = $("#pwErr", o);
    if (n.length < 10) { err.hidden = false; err.textContent = "Le nouveau mot de passe doit faire au moins 10 caractères."; return; }
    try { const r = await api("motdepasse", {ancien: $("#pwOld", o).value, nouveau: n}); if (r.token) { S.token = r.token; saveToken(); } o.remove(); toast("Mot de passe modifié."); }
    catch (e) { err.hidden = false; err.textContent = e.message; }
  };
}

/* ---------- ouverture des outils ---------- */
async function openTool(id) {
  const o = S.outils.find(x => x.id === id); if (!o || !o.actif || !o.autorise) return;
  store.set("me44.recents", [id, ...recents().filter(x => x !== id)].slice(0, 8));
  if (o.type === "lien") { try { await api("ouvrir", {id}); } catch (e) {} window.open(o.url, "_blank", "noopener"); return; }
  if (!S.tabs.includes(id)) S.tabs.push(id);
  go("t:" + id);
}
async function mountTool(id, host) {
  const o = S.outils.find(x => x.id === id);
  if (S.frames[id]) { host.appendChild(S.frames[id]); return; }
  host.innerHTML = `<div class="toolwait"><div><div class="spin"></div>Ouverture de ${esc(o.nom)}…</div></div>`;
  try {
    const r = await api("ouvrir", {id});
    if (r.demo) { host.innerHTML = `<div class="demotool">${thumb(o, "70%")}<h2>${esc(o.nom)}</h2><p>En ligne, l'outil s'ouvre ici en plein écran, après vérification de l'accès. Le portail le télécharge depuis votre Google Drive privé : il n'est jamais visible publiquement.</p><p class="note">Démonstration : aucun outil réel n'est chargé.</p></div>`; return; }
    const blob = new Blob([r.html], {type: "text/html"});
    const f = document.createElement("iframe"); f.className = "toolframe"; f.title = o.nom; f.src = URL.createObjectURL(blob);
    f.allow = "fullscreen; clipboard-write; autoplay"; f.setAttribute("allowfullscreen", "");
    S.frames[id] = f; host.innerHTML = ""; host.appendChild(f);
  } catch (e) { handleErr(e, host); }
}
function handleErr(e, host) {
  if (e.code === "SESSION" || e.code === "FERME" || e.code === "INACTIF") { logout(e.message); return; }
  if (host) host.innerHTML = `<div class="pad"><div class="err">${esc(e.message)}</div></div>`; else toast(e.message);
}

/* ---------- navigation ---------- */
function go(v) {
  S.view = v; $("#app").classList.remove("menu");
  renderNav(); renderTabs();
  const views = $("#views");
  // les outils ouverts restent montés (on ne perd pas son travail en changeant d'onglet)
  [...views.children].forEach(c => { c.hidden = c.dataset.v !== v; });
  if (v.startsWith("t:")) {
    let host = views.querySelector(`[data-v="${CSS.escape(v)}"]`);
    if (!host) { host = document.createElement("div"); host.className = "view"; host.dataset.v = v; views.appendChild(host); mountTool(v.slice(2), host); }
    host.hidden = false; return;
  }
  let host = views.querySelector(`[data-v="${v}"]`);
  if (!host) { host = document.createElement("div"); host.className = "view"; host.dataset.v = v; views.appendChild(host); }
  host.hidden = false;
  host.innerHTML = {accueil: viewHome, outils: viewOutils, favoris: viewFavoris, admin: viewAdmin, aide: viewAide}[v]();
  if (v === "admin" && !S.admin) loadAdmin().then(() => { if (S.view === "admin") go("admin"); }).catch(e => handleErr(e, host));
}
function closeTab(id) {
  S.tabs = S.tabs.filter(x => x !== id); delete S.frames[id];
  $(`#views [data-v="${CSS.escape("t:" + id)}"]`)?.remove();
  if (S.view === "t:" + id) go(S.tabs.length ? "t:" + S.tabs.at(-1) : "accueil"); else renderTabs();
}
function saveToken() { store.set("me44.token", S.token, $("#lgRemember")?.checked !== false); }
function logout(msg) { if (!DEMO) store.del("me44.token"); S.token = null; S.tabs = []; S.frames = {}; S.admin = null; S.view = "accueil"; $("#views").innerHTML = ""; showLogin(msg); }

/* ---------- événements ---------- */
document.addEventListener("click", async e => {
  const t = e.target;
  const fav = t.closest("[data-fav]"); if (fav) { e.stopPropagation(); const id = fav.dataset.fav; const f = favs(); store.set("me44.favs", f.includes(id) ? f.filter(x => x !== id) : [...f, id]); go(S.view); return; }
  const cl = t.closest("[data-close]"); if (cl) { e.stopPropagation(); closeTab(cl.dataset.close); return; }
  const nav = t.closest("[data-nav]"); if (nav) { go(nav.dataset.nav); return; }
  const tab = t.closest("[data-tab]"); if (tab) { go("t:" + tab.dataset.tab); return; }
  const cat = t.closest("[data-cat]"); if (cat) { S.cat = cat.dataset.cat; go(S.view); return; }
  const op = t.closest("[data-open]"); if (op) { openTool(op.dataset.open); return; }
  const d = t.closest("[data-do]"); if (!d) return;
  const email = d.dataset.email;
  try {
    if (d.dataset.do === "add") addDialog();
    if (d.dataset.do === "edit") editDialog(email);
    if (d.dataset.do === "off" || d.dataset.do === "on") { d.disabled = true; await api("admin.modifier", {email, champs: {actif: d.dataset.do === "on"}}); await loadAdmin(); go("admin"); toast(d.dataset.do === "on" ? "Accès réactivé." : "Accès désactivé : la personne est déconnectée."); }
    if (d.dataset.do === "portail") { await api("admin.portail", {ouvert: !S.admin.portail}); await loadAdmin(); go("admin"); toast(S.admin.portail ? "Portail ouvert." : "Portail fermé à tous."); }
  } catch (err) { handleErr(err); }
});
$("#q").addEventListener("input", e => { S.q = e.target.value; if (!["accueil", "outils"].includes(S.view)) S.view = "outils"; const pos = e.target.selectionStart; go(S.view); });
$("#burger").onclick = () => $("#app").classList.toggle("menu");
$("#btnOut").onclick = () => logout();
$("#btnPw").onclick = pwDialog;
$("#lgShow").onclick = () => { const i = $("#lgPw"); i.type = i.type === "password" ? "text" : "password"; $("#lgShow").textContent = i.type === "password" ? "Afficher" : "Masquer"; };
$("#loginForm").addEventListener("submit", async e => {
  e.preventDefault(); const b = $("#lgBtn"); b.disabled = true; b.textContent = "Connexion…"; $("#lgErr").hidden = true;
  try { const j = await api("login", {email: $("#lgEmail").value.trim().toLowerCase(), password: $("#lgPw").value, rester: $("#lgRemember").checked}); S.token = j.token; saveToken(); $("#lgPw").value = ""; enter(j); }
  catch (err) { showLogin(err.message || "Connexion impossible."); }
  finally { b.disabled = false; b.textContent = "Se connecter"; }
});
document.addEventListener("keydown", e => { if (e.key === "Escape") document.querySelector(".overlay")?.remove(); });

/* ---------- démarrage ---------- */
(async () => {
  S.token = store.get("me44.token", null);
  if (DEMO) { S.token = "demo"; enter(await api("me")); return; }
  if (!S.token) return showLogin();
  try { enter(await api("me")); } catch (e) { logout(e.code === "SESSION" ? "" : e.message); }
})();
</script>

</body>
