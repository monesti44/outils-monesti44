<script>
/* ======================================================================
   CONFIGURATION : coller ici l'URL de l'application Web Apps Script
   (Déployer > Gérer les déploiements > URL de l'application Web).
   Laisser vide = mode démonstration (aucune donnée réelle).
   ====================================================================== */
const API_URL = "https://script.google.com/macros/s/AKfycbxGd6NLXWQ5NexM7ARf2BHnswE_aoelzJRFynlan3rcizoc-oAuS3O72n3ZIkgwy3IURw/exec";
const PORTAIL_URL = "https://outils.monesti44.fr";

const $ = (s, r = document) => r.querySelector(s);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store = {
  get(k, d) { try { const v = localStorage.getItem(k) ?? sessionStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
  set(k, v, persist = true) { try { (persist ? localStorage : sessionStorage).setItem(k, JSON.stringify(v)); } catch (e) {} },
  del(k) { try { localStorage.removeItem(k); sessionStorage.removeItem(k); } catch (e) {} },
};
const DEMO = !API_URL;

/* ---------- icônes des outils ---------- */
const ICONS = {
